{
  "name": "cladora-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/test-currency-unit.mjs && node scripts/test-auth-email-callback.mjs && node scripts/test-tokenless-workspace-invitation.mjs && node scripts/test-public-apis.mjs",
    "test:i18n": "node scripts/audit-untranslated-copy.mjs",
    "test:db:static": "node scripts/check-database-package.mjs",
    "test:app-foundation": "node scripts/test-supabase-foundation.mjs",
    "test": "npm run test:unit && npm run test:i18n && npm run test:db:static && npm run test:app-foundation",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local --schema public,platform,identity,portfolio,occupancy,finance,billing,payments,utilities,assets,maintenance,governance,communications,documents,security_access,migration_hub,audit > src/types/database.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "^5.6.3"
  }
}
